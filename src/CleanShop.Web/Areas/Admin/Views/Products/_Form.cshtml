@model ProductEditViewModel
<form method="post" class="col-md-6"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="Name"></label><input asp-for="Name" class="form-control"/></div><div class="mb-3"><label asp-for="Sku"></label><input asp-for="Sku" class="form-control"/></div><div class="mb-3"><label asp-for="Price"></label><input asp-for="Price" class="form-control"/></div><div class="mb-3"><label asp-for="StockQuantity"></label><input asp-for="StockQuantity" class="form-control"/></div><button class="btn btn-primary">Save</button></form>
