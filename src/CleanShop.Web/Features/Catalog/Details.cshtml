@model ProductDetailsDto
@{ViewData["Title"]=Model.Name;}<h1>@Model.Name</h1><p>SKU: @Model.Sku</p><h3>@Model.Price.ToString("0.00") @Model.Currency</h3><p>Stock: @Model.StockQuantity</p>@if(User.Identity?.IsAuthenticated==true){<form asp-action="AddToBasket" method="post"><input type="hidden" name="id" value="@Model.Id.Value"/><div class="input-group" style="max-width:260px"><input class="form-control" type="number" name="quantity" min="1" value="1"/><button class="btn btn-primary">Add to basket</button></div></form>}else{<a class="btn btn-primary" asp-area="" asp-controller="Account" asp-action="Login">Login to buy</a>}
