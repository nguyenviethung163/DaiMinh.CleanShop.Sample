@model CleanShop.Web.Features.Account.LoginViewModel
@{ViewData["Title"]="Login";}<div class="row justify-content-center"><div class="col-md-5"><h1>Login</h1><form method="post"><input asp-for="ReturnUrl" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="username"/></div><div class="mb-3"><label asp-for="Password"></label><input asp-for="Password" class="form-control" autocomplete="current-password"/></div><div class="form-check mb-3"><input asp-for="RememberMe" class="form-check-input"/><label asp-for="RememberMe" class="form-check-label"></label></div><button class="btn btn-primary">Login</button></form><hr/><small>Demo admin: admin@cleanshop.local / CleanShop123!<br/>Demo customer: customer@cleanshop.local / CleanShop123!</small></div></div>
