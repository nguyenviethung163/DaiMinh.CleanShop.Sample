@model CleanShop.Core.Application.Basket.BasketDto
@{ViewData["Title"]="Basket";}<div class="d-flex justify-content-between"><h1>Basket</h1>@if(Model.Lines.Count>0){<a class="btn btn-success" asp-controller="Checkout" asp-action="Index">Checkout</a>}</div>@if(Model.Lines.Count==0){<div class="alert alert-info">Your basket is empty.</div>}else{<table class="table"><thead><tr><th>Product</th><th>Qty</th><th>Unit</th><th>Subtotal</th></tr></thead><tbody>@foreach(var x in Model.Lines){<tr><td>@x.ProductName</td><td>@x.Quantity</td><td>@x.UnitPrice.ToString("0.00") @x.Currency</td><td>@x.Subtotal.ToString("0.00") @x.Currency</td></tr>}</tbody></table><h4>Total: @Model.Total.ToString("0.00") @Model.Currency</h4>}
